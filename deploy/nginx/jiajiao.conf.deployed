# ============================================================
# 【线上快照，勿直接编辑】2026-10-23 抓自测试服务器
#   来源：kd211:/etc/nginx/sites-available/jiajiao.conf
#   生成者：tools/switch-domain.mjs（站点）+ deploy/harden-server.sh（全局加固 00-hardening.conf）
#   用途：让「当前线上配置」在仓库里可见、可 diff、可审计
#   改配置请改上面两个脚本，然后重新执行；本文件不会被任何脚本自动部署
# ============================================================


# ============================================================
# 家教上门撮合平台 · www.kd211.com
#   应用容器只监听 127.0.0.1:4300，全部经本反代对外
#   证书：Let's Encrypt（www.kd211.com + kd211.com），certbot.timer 自动续期
# ============================================================

server {
    listen 80;
    listen [::]:80;
    server_name www.kd211.com kd211.com;

    # certbot http-01 续期必须走 80，不能被跳转吃掉
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.kd211.com kd211.com;

    ssl_certificate     /etc/letsencrypt/live/www.kd211.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.kd211.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    client_max_body_size 8m;


    # 认证类接口限速（挡撞库 / 短信轰炸）：30r/m，突发 10（zone 见 /etc/nginx/conf.d/00-hardening.conf）
    location ~ ^/api/auth/(login|login-password|login-account|send-code|wechat) {
        limit_req zone=authlimit burst=10 nodelay;
        proxy_pass http://127.0.0.1:4300;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:4300;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location = /api/health {
        access_log off;
        proxy_pass http://127.0.0.1:4300/api/health;
        proxy_set_header Host $host;
    }
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    client_max_body_size 8m;


    # 认证类接口限速（挡撞库 / 短信轰炸）：30r/m，突发 10（zone 见 /etc/nginx/conf.d/00-hardening.conf）
    location ~ ^/api/auth/(login|login-password|login-account|send-code|wechat) {
        limit_req zone=authlimit burst=10 nodelay;
        proxy_pass http://127.0.0.1:4300;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:4300;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
