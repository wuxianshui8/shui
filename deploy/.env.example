# ============================================================
# 复制为 deploy/.env 后修改；docker compose 会自动读取同目录 .env
# ============================================================
# 必填：>= 32 字符随机串（生产未设置时应用拒绝启动）
# 生成示例：node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
AUTH_SECRET=please-change-me-to-a-random-32+-char-string

# 云服务器部署（docker-compose.prod.yml）用的 MySQL root 口令，>=16 位强随机串。
# 本地开发用 docker-compose.yml 时不需要（那边允许空口令，且 MySQL 不对外暴露）。
# 生成示例：node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
DB_PASSWORD=

# 前面有反向代理（Nginx / 云 LB）时设为 1，才会采信 X-Forwarded-For
TRUST_PROXY=0

# 定时任务（T+N 结算 / 抢单超时 / 上课提醒）：1 开启，0 关闭（灰度或排障时用）
JOBS_ENABLED=1

# ============================================================
# 短信通道（A1）：默认 mock —— 验证码只写服务端日志，不会真的发短信
#   上线改为 SMS_PROVIDER=tencent 并配齐下面 5 项（缺任何一项应用拒绝启动）
#   模板变量顺序必须是：${1}=验证码、${2}=有效期（分钟），与腾讯云控制台模板一致
# ============================================================
SMS_PROVIDER=mock
# 仅测试/预发环境：SMS_PROVIDER=mock 时把验证码写进服务端日志，便于在没有短信网关时
# 走完「发码 → 登录 / 注册」全链路。默认 0；**生产不要开**（日志出现验证码 = 验证码泄露）
SMS_MOCK_LOG_CODE=0
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou

# ============================================================
# 支付通道（A2）：默认 mock —— 不产生真实收款，仅本地/自动化可用
#   PAY_PROVIDER=wechat 时下面 7 项缺一不可（应用启动即校验，缺项拒绝启动）
#   - WECHAT_PAY_PRIVATE_KEY / PLATFORM_PUBLIC_KEY 用 PEM；.env 里可写成一整行并用 \n 表示换行
#   - APIV3_KEY 必须 32 字节；NOTIFY_URL 必须是公网 HTTPS（本机回调收不到）
# ============================================================
PAY_PROVIDER=mock
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_APIV3_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_MAX_SKEW_SECONDS=300

# ---- 证件识别（入驻认证上传身份证，P46）----
#   mock：按上传文件名「姓名_18位身份证号.png」解析，仅本地联调与自动化门禁用，不联网不花钱
#   tencent：腾讯云 IDCardOCR，下面 2 项缺一不可（配 tencent 却缺密钥 → 应用拒绝启动，不静默降级）
OCR_PROVIDER=mock
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou

# ---- 微信登录（家长端「微信一键登录」，P55）----
#   都不配 → mock：code 直接映射演示 openid（同 code 稳定同一账号，仅供联调与门禁）
#   WECHAT_APPID + WECHAT_SECRET 都配 → 小程序走 sns/jscode2session；再设 WECHAT_OAUTH=1 走公众号网页授权
#   只配一半 → 应用拒绝启动（不静默降级成 mock）
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_OAUTH=0
#   公众号网页授权回跳域名白名单（逗号分隔，只比对 origin）：authorize-url 只放行这些域名，防开放重定向
WECHAT_OAUTH_REDIRECT_ALLOWLIST=
# 公众号渠道是否再调 sns/userinfo 取昵称/头像（默认开；置 0 可省一次外部调用）
WECHAT_USERINFO=1
