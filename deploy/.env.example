# ============================================================
# 复制为 deploy/.env 后修改；docker compose 会自动读取同目录 .env
# ============================================================
# 必填：>= 32 字符随机串（生产未设置时应用拒绝启动）
# 生成示例：node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
AUTH_SECRET=please-change-me-to-a-random-32+-char-string

# 前面有反向代理（Nginx / 云 LB）时设为 1，才会采信 X-Forwarded-For
TRUST_PROXY=0

# 定时任务（T+N 结算 / 抢单超时 / 上课提醒）：1 开启，0 关闭（灰度或排障时用）
JOBS_ENABLED=1

# ============================================================
# 短信通道（A1）：默认 mock —— 验证码只写服务端日志，不会真的发短信
#   上线改为 SMS_PROVIDER=tencent 并配齐下面 5 项（缺任何一项应用拒绝启动）
#   模板变量顺序必须是：${1}=验证码、${2}=有效期（分钟），与腾讯云控制台模板一致
# ============================================================
SMS_PROVIDER=mock
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou

# ============================================================
# 支付通道（A2）：默认 mock —— 不产生真实收款，仅本地/自动化可用
#   PAY_PROVIDER=wechat 时下面 7 项缺一不可（应用启动即校验，缺项拒绝启动）
#   - WECHAT_PAY_PRIVATE_KEY / PLATFORM_PUBLIC_KEY 用 PEM；.env 里可写成一整行并用 \n 表示换行
#   - APIV3_KEY 必须 32 字节；NOTIFY_URL 必须是公网 HTTPS（本机回调收不到）
# ============================================================
PAY_PROVIDER=mock
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_APIV3_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_MAX_SKEW_SECONDS=300
